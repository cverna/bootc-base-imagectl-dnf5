# Derived image for VM (tmt/Testing Farm) testing.
#
# The minimal base image has no sshd and no network manager, so Testing Farm
# cannot reconnect to a guest after reinstalling it from the image. This
# derives a test image that only adds openssh-server and NetworkManager (the
# shipped minimal image stays minimal).
ARG BASE=ghcr.io/cverna/bootc-base-imagectl-dnf5:latest
FROM ${BASE}
RUN dnf -y install openssh-server NetworkManager \
 && dnf -y clean all \
 && rm -rf /var/cache/dnf
# sshd.service Wants=sshd-keygen.target, so this also generates host keys.
RUN systemctl enable sshd NetworkManager
LABEL containers.bootc 1
