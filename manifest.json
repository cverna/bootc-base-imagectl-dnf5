{
    "documentation": false,
    "install-weak-deps": false,
    "packages": [
        "coreutils",
        "fedora-release",
        "fedora-repos",
        "dnf5",
        "systemd",
        "systemd-udev",
        "kernel",
        "bootc",
        "ostree",
        "dracut",
        "kmod",
        "selinux-policy-targeted",
        "container-selinux",
        "policycoreutils",
        "xfsprogs",
        "e2fsprogs",
        "dosfstools",
        "efibootmgr",
        "bootupd",
        "grub2-common",
        "grub2-tools"
    ],
    "packages-aarch64": [
        "grub2-efi-aa64",
        "shim-aa64"
    ],
    "packages-x86_64": [
        "grub2-efi-x64",
        "shim-x64"
    ],
    "exclude-packages": [
        "kernel-debug",
        "kernel-debug-core",
        "kernel-debug-modules",
        "kernel-debug-modules-core",
        "kernel-debug-modules-extra",
        "kernel-debug-uki-virt"
    ]
}
