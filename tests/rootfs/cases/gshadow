#!/bin/bash
set -xeuo pipefail
# Regression test for glibc's gshadow parser (from
# fedora-coreos-config tests/kola/gshadow): a pathological line must not
# make systemd-sysusers crash.
echo 'grp0:*::root' >> /etc/gshadow
echo "grp1:*::$(printf 'somebody.a%s,' $(seq 1 47))a1234" >> /etc/gshadow
echo 'grp2:*::root' >> /etc/gshadow
systemd-sysusers
