#!/bin/bash
set -xeuo pipefail
# Only the expected setuid binaries may be present.
expected="$(cat <<'EOT' | sort
/usr/bin/chfn
/usr/bin/chsh
/usr/bin/chage
/usr/bin/gpasswd
/usr/bin/newgrp
/usr/bin/passwd
/usr/bin/grub2-set-bootflag
/usr/bin/mount
/usr/bin/pam_timestamp_check
/usr/bin/su
/usr/bin/umount
/usr/bin/unix_chkpwd
EOT
)"
actual=$(find / -xdev -perm -4000 -type f 2>/dev/null | sort)
if [ "$actual" != "$expected" ]; then
  diff <(echo "$expected") <(echo "$actual") || true
  echo "unexpected setuid set" >&2
  exit 1
fi
