#!/bin/bash
set -euo pipefail
# The writable top-level paths are symlinks into /var (and /run/media); the
# image root is read-only. The backing dirs are created at boot by tmpfiles.d
# (the committed /var is minimal), so they are declared, not present in the
# image.
test "$(readlink root)" = "var/roothome"
test "$(readlink home)" = "var/home"
test "$(readlink mnt)" = "var/mnt"
test "$(readlink srv)" = "var/srv"
test "$(readlink media)" = "run/media"
tf=usr/lib/tmpfiles.d/bootc-base-imagectl.conf
test -f "$tf"
grep -q '^d /var/roothome 0700 root root -$' "$tf"
grep -q '^d /var/home 0755 root root -$' "$tf"
grep -q '^d /run/media 0755 root root -$' "$tf"
