#!/bin/bash
# Smoke test: install the image to a loop device with `bootc install to-disk`
# and validate the resulting deployment. Needs root (losetup/mount/podman).
set -euo pipefail
img=${1:?usage: run <image-ref>}
work=$(mktemp -d -p /var/tmp)
loop=""
mnt="$work/mnt"
install_log="$work/install.log"
cleanup() {
  set +e
  mountpoint -q "$mnt" && umount "$mnt"
  [ -n "$loop" ] && losetup -D "$loop"
  rm -rf "$work"
}
diag() {
  set +e
  echo "===== diagnostics ====="
  [ -n "$loop" ] && { lsblk -f "$loop"; blkid; }
  echo "===== install log (tail) ====="
  tail -50 "$install_log" 2>/dev/null
}
trap cleanup EXIT
trap diag ERR

disk="$work/disk.raw"
truncate -s 8G "$disk"
loop=$(losetup -P --find --show "$disk")
echo "installing to $loop"

podman run --rm --privileged --pid=host --security-opt label=disable \
  -v /dev:/dev -v /var/lib/containers/storage:/var/lib/containers/storage \
  "$img" bootc install to-disk --wipe --filesystem xfs --generic-image \
    --karg=console=tty0 --karg=console=hvc0 \
    --source-imgref "containers-storage:$img" \
    --target-transport containers-storage --target-imgref "$img" "$loop" 2>&1 | tee "$install_log"

# Wait for the partition nodes to appear before mounting.
partprobe "$loop" 2>/dev/null || true
udevadm settle 2>/dev/null || true
for _ in $(seq 1 10); do
  [ -b "${loop}p2" ] && break
  sleep 1
done
lsblk -f "$loop"

# Locate the root filesystem (partition layout differs per architecture:
# x86_64 with --generic-image has BIOS boot + ESP + root; arm64 has ESP + root).
esp=$(lsblk -ln -o NAME,FSTYPE "$loop" | awk '$2=="vfat"{print "/dev/"$1; exit}')
rootpart=$(lsblk -ln -o NAME,FSTYPE "$loop" | awk '$2=="xfs"{print "/dev/"$1; exit}')
[ -n "$esp" ] || { echo "no ESP partition found" >&2; exit 1; }
[ -n "$rootpart" ] || { echo "no root (xfs) partition found" >&2; exit 1; }

mkdir -p "$mnt"
mount -o ro "$rootpart" "$mnt"

commit=$(ls "$mnt/ostree/deploy/default/deploy" | grep -v origin | head -1)
root="$mnt/ostree/deploy/default/deploy/$commit"

# Deployment content
test -f "$root"/usr/lib/modules/*/initramfs.img
test -f "$root/usr/share/rpm/rpmdb.sqlite"
[ "$(readlink "$root/usr/lib/sysimage/rpm")" = "../../share/rpm" ]

# Bootloader entry points at an initrd
bls=$(find "$mnt/boot" -path '*entries*' -name '*.conf' | head -1)
[ -n "$bls" ] || { echo "no BLS entry found" >&2; exit 1; }
grep -q '^initrd ' "$bls"

# SELinux labels are applied at install time; only checkable when the host
# enforces SELinux.
if [ -d /sys/fs/selinux ]; then
  ctx=$(ls -Z "$root/usr/bin/bash" | awk '{print $1}')
  case "$ctx" in
    *shell_exec_t*) ;;
    *) echo "unexpected SELinux context for /usr/bin/bash: $ctx" >&2; exit 1 ;;
  esac
fi

echo "disk test passed"
